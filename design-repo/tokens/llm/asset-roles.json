{
  "$description": "Closed asset-role registry, split into two contracts. clone-only roles are exact reuse of registered Cradle files and are legal only in a PageSpec with \"mode\": \"clone\" (internal reproduction of the local clone). generation-safe roles are placeholders or newly generated, original artwork: no real brands, people, logos, photos, product screenshots or proprietary content. \"generation\" is the default mode: a PageSpec without \"mode\" is a generation PageSpec. Enforced by schema/pagespec.schema.json (mode-dependent media branch) and schema/semantic_validate.py (GENERATION_SAFE_ASSETS, NO_REAL_ASSET_IN_GENERATION, NO_REAL_ENTITY_NAMES_IN_GENERATION, ASSET_ROLE_POLICY).",
  "defaultMode": "generation",
  "modes": {
    "generation": {
      "default": true,
      "allowedContracts": [
        "generation-safe"
      ],
      "description": "New pages generated by the AI team (RAG/Remix). Only generation-safe roles, never an assetRef, never a string naming a registered Cradle file, never a denylisted brand, customer or person name."
    },
    "clone": {
      "default": false,
      "allowedContracts": [
        "clone-only",
        "generation-safe"
      ],
      "description": "Exact reproduction of the local Cradle clone for fidelity QA. Must be opted into explicitly with \"mode\": \"clone\"; output is never published as a new page."
    }
  },
  "aiGenerationGuidance": {
    "forbidden": [
      "Cradle's logo, symbol, wordmark, favicons, social image or any redraw, recolour or lookalike of them.",
      "Customer, partner, investor or university logos (any registered customer-logo file, or a generated imitation of a real organisation's mark).",
      "Employee, author, investor or any real person's photo, and any generated likeness presented as a real person.",
      "Real testimonial quotes, real attributions (person names and job titles) and real customer names.",
      "Cradle product UI screenshots, video, video posters, editorial covers and lab/premises photos, or lookalikes of them.",
      "The brand name \"Cradle\" and Cradle marketing copy."
    ],
    "required": [
      "Use a fictional company name, fictional people and original copy.",
      "Use generation-safe roles only (placeholder, placeholder-logo, placeholder-avatar, placeholder-brand-mark, generated-illustration, ui-icon, hero-blob), each with a generationBrief and no assetRef.",
      "Style values come from tokens/llm/token-catalog.json via {\"token\": id} references only (see tokens/llm/token-policy.json)."
    ]
  },
