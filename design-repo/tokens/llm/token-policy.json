{
  "$description": "What a PageSpec may say about style. The only style values a PageSpec carries are the closed list of styleFields below; each must be a token reference object {\"token\": \"<id>\"} whose id exists in tokens/llm/token-catalog.json, belongs to a pageSpecReferenceable category, is one of the field's categories and starts with one of its allowedPrefixes. Raw values (hex, rgb()/rgba()/hsl(), px/rem lengths, shadows, gradients, cubic-bezier()/ms easing, Tailwind arbitrary-value or palette classes) are rejected in every string of a PageSpec, in both modes. Enforced by schema/pagespec.schema.json (per-field token enums) and schema/semantic_validate.py (TOKEN_REFS_RESOLVE, NO_RAW_STYLE_LITERALS); parity with the catalog and the section contracts is checked by extraction/verify_all.py.",
  "policyVersion": "1.1.0",
  "catalog": "tokens/llm/token-catalog.json",
  "referenceForm": {
    "shape": {
      "token": "<catalog id>"
    },
    "example": {
      "token": "color.modality.antibody"
    },
    "rejectedForms": [
      "a bare string, including \"$token:...\" or \"{color.modality.antibody}\" alias syntax",
      "{\"$token\": ...} or any object with keys other than \"token\"",
      "an id that is not in token-catalog.json",
      "any raw CSS/Tailwind value"
    ]
  },
  "categories": {
    "color": {
      "pageSpecReferenceable": true,
      "note": "Foundation palette, alpha tints and semantic colour roles."
    },
    "elevation": {
      "pageSpecReferenceable": true,
      "note": "Shadows and coloured glows."
    },
    "radius": {
      "pageSpecReferenceable": true,
      "note": "Corner radius scale."
    },
    "spacing": {
      "pageSpecReferenceable": true,
      "note": "Gap/padding steps and page-frame measurements."
    },
    "typography": {
      "pageSpecReferenceable": true,
      "note": "Families, weights, sizes, tracking and named text styles."
    },
    "component": {
      "pageSpecReferenceable": true,
      "note": "Composite presets measured from one component (a dot = colour + glow, a size preset, a padding preset). Only reachable through the styleFields that name them."
    },
    "sizing": {
      "pageSpecReferenceable": false,
      "note": "Icon/element sizes are owned by primitives and components."
    },
    "motion": {
      "pageSpecReferenceable": false,
      "note": "Easing, springs and durations are owned by section contracts; a PageSpec picks motion only through motion.pattern (closed enum) and reducedMotionFallback."
    },
    "breakpoint": {
      "pageSpecReferenceable": false,
      "note": "Responsive behaviour is owned by each section's structured responsive block."
    },
    "layout": {
      "pageSpecReferenceable": false,
      "note": "Container widths, gutters and nav height are owned by templates and chrome."
    }
  },
