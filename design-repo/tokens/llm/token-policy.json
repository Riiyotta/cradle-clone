  "rawValuePatterns": {
    "hex-color": {
      "regex": "(?<![\\w&/#])#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{3,4})(?![\\w-])",
      "example": "#3cab57"
    },
    "color-function": {
      "regex": "\\b(?:rgba?|hsla?|hwb|lab|lch|oklch|oklab|color-mix)\\s*\\(",
      "example": "rgba(60,171,87,0.4)"
    },
    "gradient-function": {
      "regex": "\\b(?:linear|radial|conic)-gradient\\s*\\(",
      "example": "linear-gradient(180deg,#fff 0%,#f9fafb 100%)"
    },
    "css-length": {
      "regex": "(?<![\\w.#-])-?(?:\\d+\\.?\\d*|\\.\\d+)(?:px|rem|em|vh|vw|vmin|vmax|pt)\\b",
      "example": "8px"
    },
    "css-math": {
      "regex": "\\b(?:calc|var|clamp|min|max)\\s*\\(\\s*[-\\w.(]",
      "example": "calc(50% - 243px)"
    },
    "easing-function": {
      "regex": "\\b(?:cubic-bezier|steps)\\s*\\(",
      "example": "cubic-bezier(0.12,0.23,0.5,1)"
    },
    "css-duration": {
      "regex": "(?<![\\w.])\\d+(?:\\.\\d+)?ms\\b",
      "example": "100ms"
    },
    "tailwind-arbitrary-class": {
      "regex": "\\b[a-z][a-z0-9:-]*-\\[[^\\]\\s]+\\]",
      "example": "shadow-[0_0_8px_0_#0ea5e9]"
    },
    "tailwind-palette-class": {
      "regex": "\\b(?:bg|text|shadow|border|ring|fill|stroke|from|via|to|decoration|outline)-(?:antibody|enzyme|vaccine|peptide|sky400|ink|brand|accent|muted|gray-\\d{2,3}|blue-\\d{2,3}|white|black)\\b",
      "example": "bg-antibody"
    }
  },
  "rawValueRestrictions": {
    "color": [
      "hex-color",
      "color-function",
      "tailwind-palette-class",
      "tailwind-arbitrary-class"
    ],
    "elevation": [
